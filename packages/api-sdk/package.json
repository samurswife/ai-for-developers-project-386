{
  "name": "@calendar/api-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/generated/nestjs.gen.d.ts",
      "import": "./dist/generated/nestjs.gen.js"
    }
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3"
  }
}
