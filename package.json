{
  "name": "calendar-calls",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "generate": "pnpm --filter @calendar/contract run generate && pnpm --filter @calendar/api-sdk run generate",
    "build:sdk": "pnpm --filter @calendar/api-sdk run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify:contract": "pnpm --filter @calendar/contract-probe run verify"
  }
}
